{
    "exclude": [
        {
            "name": "PHPUnit",
            "php": "8.1"
        }
    ],
    "additional_checks": [
        {
            "name": "PhpStan",
            "job": {
                "php": "8.2",
                "dependencies": "latest",
                "command": "composer require --dev phpstan/phpstan && vendor/bin/phpstan analyse"
            }
        }
    ]
}